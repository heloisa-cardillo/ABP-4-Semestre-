# Copie para .env e ajuste. O .env nunca vai para o Git.

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Origens de navegador liberadas no CORS, separadas por vírgula (o app móvel não precisa).
CORS_ORIGINS=

# Quantidade de proxies à frente da API (0 local; 1 atrás do load balancer da nuvem).
TRUST_PROXY=0

# Banco do docker compose. Para o banco em nuvem, use a URL do provedor (com ?sslmode=require).
DATABASE_URL=postgresql://acesso:acesso_dev@127.0.0.1:5432/controle_acesso

# Segredo do JWT: no mínimo 32 caracteres aleatórios. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
AUTH_RATE_LIMIT_MAX=10
SESSION_RATE_LIMIT_MAX=100

# Usuário administrador criado pelo seed (npx prisma db seed).
SEED_ADMIN_EMAIL=admin@acesso.local
SEED_ADMIN_PASSWORD=
# Com valor, o seed também cria dados de demonstração (edifício, terminal, condômino e visitante).
SEED_DEMO_PASSWORD=
